    "## 1b. Classical preprocessing + TF-IDF baseline (Baseline 1)\n",
    "The course requires comparing *different text representations*, not just different models. This is why classical BoW/TF-IDF needs the full preprocessing pipeline (tokenize -> lowercase -> stopword removal -> stemming), while RAPT/the transformer baseline deliberately skip all of that: a pretrained transformer already learned subword tokenization and contextual meaning during pretraining, so stemming or stripping stopwords would only destroy information it relies on."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "7314f072",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "TF-IDF + LogisticRegression macro_f1=0.7708\n",
      "TF-IDF + LinearSVC macro_f1=0.7447\n"
     ]
    }
   ],
   "source": [
    "import re\n",
    "from nltk.stem import PorterStemmer\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer, ENGLISH_STOP_WORDS\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.svm import LinearSVC\n",
    "\n",
    "stemmer = PorterStemmer()\n",
    "TOKEN_RE = re.compile(r\"[a-zA-Z']+\")\n",
    "\n",
    "\n",
    "def classical_preprocess(text):\n",
    "    # tokenize -> lowercase -> remove stopwords -> stem (classical pipeline, BoW/TF-IDF only)\n",
    "    text = re.sub(r\"https?://\\S+|www\\.\\S+\", \" \", str(text))\n",
    "    tokens = TOKEN_RE.findall(text.lower())\n",
    "    tokens = [t for t in tokens if t not in ENGLISH_STOP_WORDS and len(t) > 1]\n",
    "    tokens = [stemmer.stem(t) for t in tokens]\n",
    "    return \" \".join(tokens)\n",
    "\n",
    "\n",
    "train_df[\"text_classical\"] = train_df[\"text_marked\"].str.replace(r\"\\[/?SLUR\\]\", \"\", regex=True).apply(classical_preprocess)\n",
    "dev_df[\"text_classical\"] = dev_df[\"text_marked\"].str.replace(r\"\\[/?SLUR\\]\", \"\", regex=True).apply(classical_preprocess)\n",
    "test_df[\"text_classical\"] = test_df[\"text_marked\"].str.replace(r\"\\[/?SLUR\\]\", \"\", regex=True).apply(classical_preprocess)\n",
    "\n",
    "# sublinear_tf + liblinear solver avoid the convergence/overflow warnings seen with raw counts\n",
    "tfidf = TfidfVectorizer(max_features=5000, ngram_range=(1, 2), sublinear_tf=True)\n",
    "X_train_tfidf = tfidf.fit_transform(train_df[\"text_classical\"])\n",
    "X_test_tfidf = tfidf.transform(test_df[\"text_classical\"])\n",
    "\n",
    "lr_model = LogisticRegression(max_iter=2000, solver=\"liblinear\").fit(X_train_tfidf, train_df[\"label\"])\n",
    "svm_model = LinearSVC(max_iter=5000).fit(X_train_tfidf, train_df[\"label\"])\n",
    "\n",
    "lr_f1 = f1_score(test_df[\"label\"], lr_model.predict(X_test_tfidf), average=\"macro\")\n",
    "svm_f1 = f1_score(test_df[\"label\"], svm_model.predict(X_test_tfidf), average=\"macro\")\n",
    "print(f\"TF-IDF + LogisticRegression macro_f1={lr_f1:.4f}\")\n",
    "print(f\"TF-IDF + LinearSVC macro_f1={svm_f1:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "642c926e",
   "metadata": {},
   "source": [
    "## 2. Tokenizer + slur-span index helper (bug-fixed)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "94f41449",
   "metadata": {},
   "outputs": [],
   "source": [
    "tokenizer = AutoTokenizer.from_pretrained(\"xlm-roberta-base\")\n",
    "\n",
    "\n",
    "def get_slur_span_token_indices(tokenizer, marked_text):\n",
    "    # returns token positions of the [SLUR]...[/SLUR] span (None if no span,\n",
    "    # or if the span got cut off by truncation on long comments)\n",
    "    if \"[SLUR]\" not in marked_text:\n",
    "        enc = tokenizer(marked_text, truncation=True, padding=\"max_length\",\n",
    "                         max_length=MAX_LEN, return_tensors=\"pt\")\n",
    "        return enc[\"input_ids\"], enc[\"attention_mask\"], None, None\n",
    "\n",
    "    before, rest = marked_text.split(\"[SLUR]\", 1)\n",
    "    span_text, after = rest.split(\"[/SLUR]\", 1)\n",
    "    before_ids = tokenizer(before, add_special_tokens=False)[\"input_ids\"]\n",
    "    span_ids = tokenizer(span_text.strip(), add_special_tokens=False)[\"input_ids\"]\n",
    "\n",
    "    slur_start = len(before_ids) + 1  # +1 for [CLS]\n",
    "    slur_end = slur_start + len(span_ids)\n",
    "\n",
    "    clean_text = (before + span_text + after).strip()\n",
    "    enc = tokenizer(clean_text, truncation=True, padding=\"max_length\",\n",
    "                     max_length=MAX_LEN, return_tensors=\"pt\")\n",
    "\n",
    "    # BUG FIX: on long Reddit comments, truncation to MAX_LEN can cut the slur\n",
    "    # span off entirely. An out-of-range slice (e.g. H[i, 130:135]) is EMPTY,\n",
    "    # and .mean() of an empty tensor is NaN -> poisons the whole model from\n",
    "    # step 1. Guard by falling back to \"no span\" (h_cls only) in that case.\n",
    "    if slur_start >= MAX_LEN - 1 or slur_end > MAX_LEN - 1:\n",
    "        return enc[\"input_ids\"], enc[\"attention_mask\"], None, None\n",
    "\n",
    "    return enc[\"input_ids\"], enc[\"attention_mask\"], slur_start, slur_end"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cbe24c3e",
   "metadata": {},
   "source": [
    "## 3. PyTorch Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "48f69746",
   "metadata": {},
   "outputs": [],
   "source": [
    "class SlurDataset(Dataset):\n",
    "    def __init__(self, df, tokenizer, use_spans):\n",
    "        self.df = df.reset_index(drop=True)\n",
    "        self.tokenizer = tokenizer\n",
    "        self.use_spans = use_spans\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.df)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        row = self.df.iloc[idx]\n",
    "        text, label, lang = row[\"text_marked\"], int(row[\"label\"]), row[\"lang\"]\n",
    "\n",
    "        if self.use_spans:\n",
    "            input_ids, attention_mask, s, e = get_slur_span_token_indices(self.tokenizer, text)\n",
    "            s, e = (s if s is not None else -1), (e if e is not None else -1)\n",
    "        else:\n",
    "            clean = text.replace(\"[SLUR]\", \"\").replace(\"[/SLUR]\", \"\").strip()\n",
    "            enc = self.tokenizer(clean, truncation=True, padding=\"max_length\",\n",
    "                                  max_length=MAX_LEN, return_tensors=\"pt\")\n",
    "            input_ids, attention_mask = enc[\"input_ids\"], enc[\"attention_mask\"]\n",
    "            s, e = -1, -1\n",
    "\n",
    "        return {\n",
    "            \"input_ids\": input_ids.squeeze(0),\n",
    "            \"attention_mask\": attention_mask.squeeze(0),\n",
    "            \"slur_start\": torch.tensor(s, dtype=torch.long),\n",
    "            \"slur_end\": torch.tensor(e, dtype=torch.long),\n",
    "            \"label\": torch.tensor(label, dtype=torch.long),\n",
    "            \"lang\": lang,\n",
    "        }\n",
    "\n",
    "\n",
    "def collate_fn(batch):\n",
    "    return {\n",
    "        \"input_ids\": torch.stack([b[\"input_ids\"] for b in batch]),\n",
    "        \"attention_mask\": torch.stack([b[\"attention_mask\"] for b in batch]),\n",
    "        \"slur_start\": torch.stack([b[\"slur_start\"] for b in batch]),\n",
    "        \"slur_end\": torch.stack([b[\"slur_end\"] for b in batch]),\n",
    "        \"label\": torch.stack([b[\"label\"] for b in batch]),\n",
    "        \"lang\": [b[\"lang\"] for b in batch],\n",
    "    }"
   ]
  },
