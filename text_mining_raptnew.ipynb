   "cell_type": "markdown",
   "id": "46ac37a0",
   "metadata": {},
   "source": [
    "## 4. Models — RAPT (main) + CLS-only baseline (for comparative evaluation)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "10178cb6",
   "metadata": {},
   "outputs": [],
   "source": [
    "class ClassificationHead(nn.Module):\n",
    "    def __init__(self, input_dim, hidden_dim=256, dropout=0.2):\n",
    "        super().__init__()\n",
    "        self.fc1 = nn.Linear(input_dim, hidden_dim)\n",
    "        self.act = nn.GELU()\n",
    "        self.dropout = nn.Dropout(dropout)\n",
    "        self.fc2 = nn.Linear(hidden_dim, 2)  # DEG (1) vs. non-DEG (0)\n",
    "\n",
    "    def forward(self, h):\n",
    "        return self.fc2(self.dropout(self.act(self.fc1(h))))\n",
    "\n",
    "\n",
    "class RAPTModel(nn.Module):\n",
    "    # span-aware: fuses h_slur (local slur term) + h_cls (global comment)\n",
    "    def __init__(self, encoder_name=\"xlm-roberta-base\", dropout=0.2):\n",
    "        super().__init__()\n",
    "        self.encoder = AutoModel.from_pretrained(encoder_name)\n",
    "        hidden_dim = self.encoder.config.hidden_size\n",
    "        self.head = ClassificationHead(2 * hidden_dim, dropout=dropout)\n",
    "\n",
    "    def forward(self, input_ids, attention_mask, slur_start, slur_end):\n",
    "        H = self.encoder(input_ids=input_ids, attention_mask=attention_mask).last_hidden_state\n",
    "        h_cls = H[:, 0, :]\n",
    "        h_slur = torch.zeros_like(h_cls)\n",
    "        for i in range(H.size(0)):\n",
    "            s, e = int(slur_start[i]), int(slur_end[i])\n",
    "            h_slur[i] = H[i, s:e, :].mean(dim=0) if (s >= 0 and e > s) else h_cls[i]\n",
    "        h = torch.cat([h_slur, h_cls], dim=-1)\n",
    "        return self.head(h), h_slur, h_cls\n",
    "\n",
    "\n",
    "class ClsOnlyBaseline(nn.Module):\n",
    "    # plain [CLS] -> linear, no span awareness (comparison baseline)\n",
    "    def __init__(self, encoder_name=\"xlm-roberta-base\", dropout=0.2):\n",
    "        super().__init__()\n",
    "        self.encoder = AutoModel.from_pretrained(encoder_name)\n",
    "        self.head = ClassificationHead(self.encoder.config.hidden_size, dropout=dropout)\n",
    "\n",
    "    def forward(self, input_ids, attention_mask, slur_start=None, slur_end=None):\n",
    "        H = self.encoder(input_ids=input_ids, attention_mask=attention_mask).last_hidden_state\n",
    "        h_cls = H[:, 0, :]\n",
    "        return self.head(h_cls), h_cls\n",
    "\n",
    "\n",
    "def contrastive_loss(h_slur, labels, margin=1.0):\n",
    "    # optional (Plan A 6.2): same-label pairs pulled together, different pushed apart\n",
    "    b, loss, count = h_slur.size(0), 0.0, 0\n",
    "    for i in range(b):\n",
    "        for j in range(i + 1, b):\n",
    "            dist = torch.norm(h_slur[i] - h_slur[j], p=2)\n",
    "            loss += dist ** 2 if labels[i] == labels[j] else torch.clamp(margin - dist, min=0) ** 2\n",
    "            count += 1\n",
    "    return loss / max(count, 1)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8a5562e6",
   "metadata": {},
   "source": [
    "## 5. Train / evaluate (now tracks history for plotting + gradient clipping for stability)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "19577bc5",
   "metadata": {},
   "outputs": [],
   "source": [
    "@torch.no_grad()\n",
    "def evaluate(model, loader, use_spans):\n",
    "    model.eval()\n",
    "    preds, labels, langs = [], [], []\n",
    "    for batch in loader:\n",
    "        ii, am = batch[\"input_ids\"].to(device), batch[\"attention_mask\"].to(device)\n",
    "        if use_spans:\n",
    "            logits, _, _ = model(ii, am, batch[\"slur_start\"].to(device), batch[\"slur_end\"].to(device))\n",
    "        else:\n",
    "            logits, _ = model(ii, am)\n",
    "        preds.extend(torch.argmax(logits, -1).cpu().tolist())\n",
    "        labels.extend(batch[\"label\"].tolist())\n",
    "        langs.extend(batch[\"lang\"])\n",
    "    overall = f1_score(labels, preds, average=\"macro\")\n",
    "    per_lang = {l: f1_score([y for y, g in zip(labels, langs) if g == l],\n",
    "                             [p for p, g in zip(preds, langs) if g == l], average=\"macro\")\n",
    "                for l in set(langs)}\n",
    "    return overall, per_lang, preds, labels\n",
    "\n",
    "\n",
    "def train_model(model, train_loader, dev_loader, use_spans, epochs=4, lr=2e-5,\n",
    "                 contrastive_lambda=0.0, ckpt=\"best_model.pt\"):\n",
    "    optim = torch.optim.AdamW(model.parameters(), lr=lr)\n",
    "    ce = nn.CrossEntropyLoss()\n",
    "    best_f1 = -1.0\n",
    "    history = {\"train_loss\": [], \"dev_f1\": []}\n",
    "\n",
    "    for epoch in range(epochs):\n",
    "        model.train()\n",
    "        total_loss = 0.0\n",
    "        for batch in train_loader:\n",
    "            ii, am, y = batch[\"input_ids\"].to(device), batch[\"attention_mask\"].to(device), batch[\"label\"].to(device)\n",
    "            optim.zero_grad()\n",
    "            if use_spans:\n",
    "                logits, h_slur, _ = model(ii, am, batch[\"slur_start\"].to(device), batch[\"slur_end\"].to(device))\n",
    "                loss = ce(logits, y)\n",
    "                if contrastive_lambda > 0:\n",
    "                    loss = loss + contrastive_lambda * contrastive_loss(h_slur, y)\n",
    "            else:\n",
    "                logits, _ = model(ii, am)\n",
    "                loss = ce(logits, y)\n",
    "            loss.backward()\n",
    "            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)  # extra safety vs. exploding grads\n",
    "            optim.step()\n",
    "            total_loss += loss.item()\n",
    "\n",
    "        avg_loss = total_loss / len(train_loader)\n",
    "        dev_f1, dev_per_lang, _, _ = evaluate(model, dev_loader, use_spans)\n",
    "        history[\"train_loss\"].append(avg_loss)\n",
    "        history[\"dev_f1\"].append(dev_f1)\n",
    "        print(f\"epoch {epoch+1}/{epochs} loss={avg_loss:.4f} dev_f1={dev_f1:.4f} {dev_per_lang}\")\n",
    "        if dev_f1 > best_f1:\n",
    "            best_f1 = dev_f1\n",
    "            torch.save(model.state_dict(), ckpt)\n",
    "\n",
    "    model.load_state_dict(torch.load(ckpt))\n",
    "    return model, history\n",
    "\n",
    "\n",
    "def plot_training_curves(history, title):\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(11, 4))\n",
    "    axes[0].plot(history[\"train_loss\"], marker=\"o\")\n",
    "    axes[0].set_title(f\"{title} — training loss\")\n",
    "    axes[0].set_xlabel(\"epoch\")\n",
