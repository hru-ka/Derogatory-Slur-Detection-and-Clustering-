    "@torch.no_grad()\n",
    "def extract_embeddings(model, loader):\n",
    "    model.eval()\n",
    "    embeddings, labels = [], []\n",
    "    for batch in loader:\n",
    "        ii, am = batch[\"input_ids\"].to(device), batch[\"attention_mask\"].to(device)\n",
    "        _, _, h_cls = model(ii, am, batch[\"slur_start\"].to(device), batch[\"slur_end\"].to(device))\n",
    "        embeddings.append(h_cls.cpu().numpy())\n",
    "        labels.extend(batch[\"label\"].tolist())\n",
    "    return np.vstack(embeddings), np.array(labels)\n",
    "\n",
    "\n",
    "X, y_true = extract_embeddings(rapt_model, test_loader)\n",
    "\n",
    "kmeans = KMeans(n_clusters=2, random_state=42, n_init=10)\n",
    "cluster_labels = kmeans.fit_predict(X)\n",
    "\n",
    "ari = adjusted_rand_score(y_true, cluster_labels)\n",
    "print(f\"Adjusted Rand Index vs. true labels: {ari:.4f}\")\n",
    "\n",
    "if len(set(cluster_labels)) > 1:\n",
    "    sil = silhouette_score(X, cluster_labels)\n",
    "    print(f\"Silhouette score: {sil:.4f}\")\n",
    "else:\n",
    "    print(\"Only one cluster found — try a different k or check embedding variance.\")\n",
    "\n",
    "pca = PCA(n_components=2, random_state=42)\n",
    "X_2d = pca.fit_transform(X)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
    "axes[0].scatter(X_2d[:, 0], X_2d[:, 1], c=cluster_labels, cmap=\"coolwarm\", alpha=0.6)\n",
    "axes[0].set_title(\"K-means clusters\")\n",
    "axes[1].scatter(X_2d[:, 0], X_2d[:, 1], c=y_true, cmap=\"coolwarm\", alpha=0.6)\n",
    "axes[1].set_title(\"True labels (DEG / non-DEG)\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
