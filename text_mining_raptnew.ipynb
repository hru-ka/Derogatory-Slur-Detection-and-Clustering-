   "metadata": {},
   "source": [
    "## 1. Load & preprocess Slur Corpus"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "0b469661",
   "metadata": {},
   "outputs": [],
   "source": [
    "DATA_PATH = (\"/Users/hrubaruh/Desktop/text mining /kurrek.2020.slur-corpus.csv\")\n",
    "SAMPLE_SIZE = 8000    # subsample for faster training; set to None to use all 40k rows\n",
    "DROP_DISAGREEMENT = False   # set True to drop rows where annotators disagreed (~22% of data)\n",
    "\n",
    "URL_RE = re.compile(r\"https?://\\S+|www\\.\\S+\")\n",
    "ELONGATED_RE = re.compile(r\"(.)\\1{2,}\")\n",
    "SAMPLE_SIZE = 8000    # subsample for faster training; set to None to use all 40k rows\n",
    "DROP_DISAGREEMENT = False   # set True to drop rows where annotators disagreed (~22% of data)\n",
    "\n",
    "URL_RE = re.compile(r\"https?://\\S+|www\\.\\S+\")\n",
    "ELONGATED_RE = re.compile(r\"(.)\\1{2,}\")\n",
    "KNOWN_SLURS = [\"tranny\", \"nigger\", \"faggot\"]   # the 3 terms this dataset covers\n",
    "\n",
    "\n",
    "def normalize_text(text):\n",
    "    # URL removal + collapse elongated chars (Reddit comments, no @mentions/hashtags to strip)\n",
    "    if not isinstance(text, str):\n",
    "        return \"\"\n",
    "    text = URL_RE.sub(\"<URL>\", text)\n",
    "    text = ELONGATED_RE.sub(r\"\\1\\1\", text)\n",
    "    return text.strip()\n",
    "\n",
    "\n",
    "def mark_slur_span(text, slur):\n",
    "    # wraps the EXACT slur given by the dataset's own `slur` column\n",
    "    if not isinstance(slur, str) or not slur:\n",
    "        return text\n",
    "    pattern = re.compile(rf\"\\b({re.escape(slur)})\\b\", flags=re.IGNORECASE)\n",
    "    marked, n = pattern.subn(r\"[SLUR] \\1 [/SLUR]\", text, count=1)\n",
    "    return marked if n > 0 else text  # fallback: exact form not found (e.g. inflection)\n",
    "\n",
    "\n",
    "def map_label(gold_label):\n",
    "    return 1 if str(gold_label).strip().upper() == \"DEG\" else 0\n"
   ]
  },
