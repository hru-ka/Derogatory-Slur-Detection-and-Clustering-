    "import ipywidgets as widgets\n",
    "from IPython.display import display\n",
    "\n",
    "\n",
    "def classify_sentence(model, tokenizer, text):\n",
    "    model.eval()\n",
    "    normalized = normalize_text(text)\n",
    "    marked, found_slur = normalized, None\n",
    "    for term in KNOWN_SLURS:\n",
    "        if re.search(rf\"\\b{re.escape(term)}\\b\", normalized, flags=re.IGNORECASE):\n",
    "            marked = mark_slur_span(normalized, term)\n",
    "            found_slur = term\n",
    "            break\n",
    "\n",
    "    input_ids, attention_mask, s, e = get_slur_span_token_indices(tokenizer, marked)\n",
    "    input_ids, attention_mask = input_ids.to(device), attention_mask.to(device)\n",
    "    slur_start = torch.tensor([s if s is not None else -1]).to(device)\n",
    "    slur_end = torch.tensor([e if e is not None else -1]).to(device)\n",
    "\n",
    "    with torch.no_grad():\n",
    "        logits, _, _ = model(input_ids, attention_mask, slur_start, slur_end)\n",
    "        probs = torch.softmax(logits, dim=-1)[0]\n",
    "\n",
    "    pred = int(torch.argmax(probs))\n",
    "    label = \"DEROGATORY (slur used to attack)\" if pred == 1 else \"NOT DEROGATORY\"\n",
    "    return label, probs[1].item(), found_slur\n",
    "\n",
    "\n",
    "text_input = widgets.Text(\n",
    "    placeholder=\"Type a sentence...\",\n",
    "    description=\"Sentence:\",\n",
    "    layout=widgets.Layout(width=\"600px\"),\n",
    ")\n",
    "classify_button = widgets.Button(description=\"Classify\", button_style=\"primary\")\n",
    "output_box = widgets.Output()\n",
    "\n",
    "\n",
    "def on_classify_click(b):\n",
    "    output_box.clear_output()\n",
    "    with output_box:\n",
    "        if not text_input.value.strip():\n",
    "            print(\"Type a sentence first.\")\n",
    "            return\n",
    "        label, prob_deg, slur_found = classify_sentence(rapt_model, tokenizer, text_input.value)\n",
    "        print(f\"Detected slur term : {slur_found or 'none of the 3 known terms found'}\")\n",
    "        print(f\"Prediction          : {label}\")\n",
    "        print(f\"P(derogatory)       : {prob_deg:.3f}\")\n",
    "\n",
    "\n",
    "classify_button.on_click(on_classify_click)\n",
    "display(text_input, classify_button, output_box)"
   ]
