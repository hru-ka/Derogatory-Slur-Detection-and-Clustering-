    "df = pd.read_csv(DATA_PATH).dropna(subset=[\"body\", \"slur\", \"gold_label\"])\n",
    "\n",
    "if DROP_DISAGREEMENT and \"disagreement\" in df.columns:\n",
    "    df = df[df[\"disagreement\"] == False]\n",
    "\n",
    "if SAMPLE_SIZE is not None and len(df) > SAMPLE_SIZE:\n",
    "    df = df.sample(n=SAMPLE_SIZE, random_state=42)\n",
    "\n",
    "df[\"lang\"] = \"en\"  # single language; kept only so per-lang eval code below still works\n",
    "df[\"text_norm\"] = df[\"body\"].apply(normalize_text)\n",
    "df[\"text_marked\"] = df.apply(lambda r: mark_slur_span(r[\"text_norm\"], r[\"slur\"]), axis=1)\n",
    "df[\"label\"] = df[\"gold_label\"].apply(map_label)\n",
    "df = df[[\"id\", \"lang\", \"text_marked\", \"label\"]]\n",
    "\n",
    "train_df, temp_df = train_test_split(df, test_size=0.30, stratify=df[\"label\"], random_state=42)\n",
    "dev_df, test_df = train_test_split(temp_df, test_size=0.50, stratify=temp_df[\"label\"], random_state=42)\n",
    "\n",
    "print(f\"train={len(train_df)} dev={len(dev_df)} test={len(test_df)}\")\n",
    "print(train_df[\"label\"].value_counts())\n",
    "\n",
    "# class balance check (visual)\n",
    "train_df[\"label\"].value_counts().sort_index().plot(kind=\"bar\", color=[\"#4C72B0\", \"#C44E52\"])\n",
    "plt.xticks([0, 1], [\"non-DEG\", \"DEG\"], rotation=0)\n",
    "plt.title(\"Train set class balance\")\n",
    "plt.ylabel(\"count\")\n",
    "plt.show()"
   ]
